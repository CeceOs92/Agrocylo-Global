# ── Backend ────────────────────────────────────────────────────────────────
# Single backend base URL — used for REST + Socket.io.
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Stellar / Soroban ──────────────────────────────────────────────────────
# SINGLE SOURCE OF TRUTH for which network the app targets. "testnet" | "mainnet".
# When unset the app infers "mainnet" from a mainnet passphrase below, otherwise
# defaults to "testnet" (safe for local dev). Set it explicitly for any deploy.
#
# FAIL-FAST CONTRACT: when this is "mainnet", the app will NOT silently fall back
# to testnet. Missing/invalid network config throws at build time (next.config.ts)
# and at runtime (getNetworkConfig / resolveNetworkPassphrase / getRpcServer), and
# transaction-capable UI renders a configuration-error state instead of a working
# form. The testnet fallback is kept ONLY for "testnet" / unset.
NEXT_PUBLIC_STELLAR_ENV=testnet

# Soroban RPC endpoint. REQUIRED — must match the network passphrase below.
# Testnet: https://soroban-testnet.stellar.org
# Mainnet: https://soroban-rpc.mainnet.stellar.org
# Local: http://localhost:8000
NEXT_PUBLIC_SOROBAN_RPC_URL=

# Stellar network passphrase. REQUIRED — must match the RPC endpoint above.
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
# Do NOT leave this unset — the app fails the build if missing, and in mainnet
# mode a missing/testnet value is a hard runtime error (no silent fallback).
NEXT_PUBLIC_NETWORK_PASSPHRASE=

# Horizon endpoint. Optional — defaults follow NEXT_PUBLIC_STELLAR_ENV.
# Testnet: https://horizon-testnet.stellar.org  Mainnet: https://horizon.stellar.org
NEXT_PUBLIC_HORIZON_URL=

# ── Contracts ──────────────────────────────────────────────────────────────
# Deployed Agrocylo escrow contract. Required for all on-chain calls.
# Gates transaction-capable UI via isContractConfigured(); in mainnet mode a
# missing value (or invalid network config) disables checkout/escrow entirely.
NEXT_PUBLIC_CONTRACT_ID=

# Stellar Asset Contract for native XLM — required by /orders/new.
# Testnet XLM SAC: CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
NEXT_PUBLIC_NATIVE_TOKEN_CONTRACT_ID=

# Optional fallback token contract (used by some legacy flows).
NEXT_PUBLIC_TOKEN_CONTRACT_ID=

# Currency-specific token contracts (used by the cart / checkout flow).
NEXT_PUBLIC_TOKEN_CONTRACT_ID_USDC=
NEXT_PUBLIC_TOKEN_CONTRACT_ID_XLM=
NEXT_PUBLIC_TOKEN_CONTRACT_ID_STRK=

# ── Agro Production App ─────────────────────────────────────────────────────
# URL of the agro-production sub-app. Used by the header nav link.
NEXT_PUBLIC_AGRO_PRODUCTION_URL=http://localhost:3001

# ── Demo / Test Mode ─────────────────────────────────────────────────────────
# When set to true, services return deterministic dummy data instead of hitting
# the real backend or Soroban RPC. Used by Playwright E2E tests and local dev.
# Do NOT set in production.
NEXT_PUBLIC_DEMO_MODE=false
