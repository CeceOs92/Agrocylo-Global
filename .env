# Development defaults for docker compose.
# Override any value locally — these exist so `docker compose up` works
# out-of-the-box without manual .env creation.

# ── Root server (server/) ──────────────────────────────────────────────
DATABASE_URL=postgresql://agrocylo:agrocylo123@postgres:5432/agrocylo_db
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key-for-local-development-only
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-for-local-dev
SUPABASE_JWT_SECRET=placeholder-jwt-secret-for-local-dev-only
JWT_SECRET=b873d25323eb8673ad2d4ef5a86f7181ddb5f3cae3ed14c5fd8573c5b1d5f5e8
REDIS_URL=redis://redis:6379

# ── Agro-production server (agro-production/server/) ───────────────────
AGRO_DATABASE_URL=postgresql://agrocylo:agrocylo123@postgres-agro:5432/agrocylo_production

# ── Clients (NEXT_PUBLIC_* are baked into the client at build time) ────
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_AGRO_PRODUCTION_URL=http://localhost:3001
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_DEMO_MODE=false
